# Shared-workspace token-refresher sidecar.
FROM python:3.14-slim

RUN pip install --no-cache-dir requests==2.33.0

# cache_reconcile provides the shared VFS-cache dirty-entry scanner the refresher
# imports for write-back health (it reads the same cache the gateway writes).
COPY refresher.py /app/refresher.py
COPY cache_reconcile.py /app/cache_reconcile.py
WORKDIR /app

# Run as non-root.
RUN useradd --create-home --uid 65532 refresher
USER 65532

ENTRYPOINT ["python", "/app/refresher.py"]
